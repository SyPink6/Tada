# Tada LLM proxy — OpenAI-compatible endpoint.
# Copy this file to `.env` (same folder) and fill in your values.
# `.env` is gitignored; never commit your real key. Leave OPENAI_API_KEY
# empty to keep the web preview in labeled "example/demo" mode.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
